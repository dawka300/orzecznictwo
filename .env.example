# Skopiuj do .env (nie trafia do gita) i uzupełnij. Zmienne środowiska mają
# pierwszeństwo przed .env. Bez wpisu: wartości domyślne z judgments_core/settings.py.

# --- NSA / CBOSA ---
# Lokalnie (docker compose): mysql://szkielet:szkielet@127.0.0.1:3306/nsa
# Na hostingu: dane bazy z panelu seohost, np. mysql://uzytkownik:haslo@localhost:3306/uzytkownik_nsa
NSA_DB_DSN=mysql://szkielet:szkielet@127.0.0.1:3306/nsa
NSA_USER_AGENT=orzecznictwo-szkielet/0.1 (projekt prywatny; kontakt: TWOJ_EMAIL)
NSA_PAUSE_S=2
# Jeden przebieg z crona: zakończ po tylu sekundach (krócej niż limit hostingu).
NSA_TIME_BUDGET_S=240
NSA_LOG_DIR=logs

# --- ETPC / HUDOC ---
ETPC_DB_DSN=mysql://szkielet:szkielet@127.0.0.1:3306/etpc
ETPC_USER_AGENT=orzecznictwo-szkielet/0.1 (projekt prywatny; kontakt: TWOJ_EMAIL)
ETPC_PAUSE_S=2
ETPC_TIME_BUDGET_S=240
ETPC_LOG_DIR=logs

# Środowisko: prod (komputer użytkownika, 32 GB) albo dev (komputer dewelopera, 64 GB:
# docker-compose.dev.yml i funkcje tylko dla dewelopera). COMPOSE_FILE wybiera wtedy
# docker-compose.<APP_ENV>.yml, który nadpisuje docker-compose.yml.
APP_ENV=prod
COMPOSE_FILE=docker-compose.yml;docker-compose.${APP_ENV:-prod}.yml
